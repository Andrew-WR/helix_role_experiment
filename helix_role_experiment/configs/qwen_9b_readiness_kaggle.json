    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "trainable_top_layers": 4,
    "review_margin": 0.08,
    "minimum_event_threshold": 0.5,
    "target_event_precision": 0.5,
    "memory_min_confidence": 0.8
